{
	"name": "agentforce-vibes-autocomplete",
	"displayName": "Agentforce Vibes Autocomplete",
	"description": "AI-powered code completions for Salesforce development",
	"version": "1.0.3",
	"publisher": "salesforce",
	"aiKey": "ec3632a4-df47-47a4-98dc-8134cacbaf7e",
	"o11yUploadEndpoint": "https://794testsite.my.site.com/byolwr/webruntime/log/metrics",
	"enableO11y": "true",
	"productFeatureId": "aJCEE0000000mCe4AI",
	"qna": "https://github.com/forcedotcom/Einstein-GPT-for-Developers/issues",
	"bugs": {
		"url": "https://github.com/forcedotcom/Einstein-GPT-for-Developers/issues"
	},
	"repository": {
		"url": "https://github.com/forcedotcom/Einstein-GPT-for-Developers"
	},
	"icon": "images/AgentforceVibes.png",
	"license": "BSD-3-Clause",
	"engines": {
		"vscode": "^1.86.0"
	},
	"categories": [
		"Other"
	],
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run bundle:extension && npm run update-for-packaging",
		"compile": "tsc --noEmit && node ./esbuild.js",
		"clean": "rimraf dist out .vscode-test",
		"watch": "tsc --noEmit --watch",
		"prettier": "prettier --write .",
		"prettier-check": "prettier --check .",
		"lint": "eslint .",
		"lint-fix": "eslint --fix .",
		"update-snapshots": "jest --updateSnapshot",
		"test": "jest --coverage",
		"test:watch": "jest --watch --coverage",
		"bundle:extension": "node ./esbuild.js --production",
		"bundle:vsix": "npm run compile && vsce package --follow-symlinks",
		"update-for-packaging": "ts-node scripts/updatePackageJsonForVSIX.ts",
		"check-vsix-size": "ts-node scripts/vsix-size-check/check-vsix-size.ts",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.1",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@estruyf/vscode": "^1.2.0",
		"@langfuse/client": "^4.5.1",
		"@langfuse/otel": "^4.5.1",
		"@langfuse/tracing": "^4.5.1",
		"@opentelemetry/sdk-node": "^0.206.0",
		"@playwright/test": "^1.45.3",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@tony.ganchev/eslint-plugin-header": "^3.1.11",
		"@types/diff": "^5.0.7",
		"@types/jest": "^29.5.1",
		"@types/node": "^22",
		"@types/prompts": "^2.4.9",
		"@types/semver": "^7.7.0",
		"@types/shelljs": "^0.8.15",
		"@types/testing-library__react": "^10.2.0",
		"@types/vscode": "^1.86.0",
		"@types/vscode-webview": "^1.57.5",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.7.1",
		"commander": "^13.0.0",
		"concurrently": "^8.2.2",
		"esbuild": "^0.27.2",
		"esbuild-visualizer": "^0.7.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^28.8.3",
		"eslint-plugin-playwright": "^2.5.0",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"execa": "^9.6.0",
		"extract-zip": "^2.0.1",
		"find-process": "^1.4.7",
		"husky": "^9.1.7",
		"jest": "^29.5.0",
		"jest-environment-jsdom": "^29.5.0",
		"lint-staged": "^16.2.7",
		"npm-run-all": "^4.1.5",
		"ovsx": "^0.10.8",
		"prettier": "^3.8.1",
		"prompts-ncu": "^3.0.2",
		"rimraf": "^6.1.2",
		"shelljs": "^0.8.5",
		"simple-git": "^3.30.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.18.2"
	},
	"dependencies": {
		"@salesforce/vscode-service-provider": "^1.3.0-rc.6.5",
		"@vscode/codicons": "^0.0.38",
		"axios": "^1.12.2",
		"diff": "^5.1.0",
		"einstein-shared": "github:forcedotcom/salesforcedx-vscode-einstein-shared#semver:0.3.12",
		"openai": "^4.46.1",
		"zod": "^3.25.76",
		"semver": "^7.7.2"
	},
	"main": "dist/extension.js",
	"l10n": "./l10n",
	"activationEvents": [
		"workspaceContains:sfdx-project.json"
	],
	"extensionDependencies": [
		"salesforce.salesforcedx-vscode-core",
		"salesforce.salesforcedx-einstein-gpt"
	],
	"contributes": {
		"commands": [
			{
				"command": "salesforce.agentforceVibesAutocomplete.displayStatusMenu",
				"title": "%salesforcedx-einstein-gpt.displayStatusMenu.title%"
			},
			{
				"command": "salesforce.agentforceVibesAutocomplete.toggleAutocompletions",
				"title": "%salesforcedx-einstein-gpt.toggleEinsteinAutoCompletions.title%"
			},
			{
				"command": "salesforce.agentforceVibesAutocomplete.toggleAutocompletionsForCurrentFileType",
				"title": "%salesforcedx-einstein-gpt.toggleEinsteinAutoCompletionsForCurrentFileType.title%"
			},
			{
				"command": "salesforce.agentforceVibesAutocomplete.acceptSuggestion",
				"title": "%salesforcedx-einstein-gpt.acceptSuggestion.title%",
				"when": "never"
			},
			{
				"command": "salesforce.agentforceVibesAutocomplete.clearSuggestion",
				"title": "%salesforcedx-einstein-gpt.clearSuggestion.title%",
				"when": "never"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "salesforce.agentforceVibesAutocomplete.displayStatusMenu",
					"when": "salesforcedx-einstein-gpt.isEnabled"
				},
				{
					"command": "salesforce.agentforceVibesAutocomplete.toggleAutocompletions",
					"when": "salesforcedx-einstein-gpt.isEnabled"
				},
				{
					"command": "salesforce.agentforceVibesAutocomplete.toggleAutocompletionsForCurrentFileType",
					"when": "(editorLangId == 'apex'|| editorLangId == 'javascript' || editorLangId == 'css' || editorLangId == 'html') && salesforcedx-einstein-gpt.isEnabled"
				},
				{
					"command": "salesforce.agentforceVibesAutocomplete.acceptSuggestion",
					"when": "never"
				},
				{
					"command": "salesforce.agentforceVibesAutocomplete.clearSuggestion",
					"when": "never"
				}
			]
		},
		"keybindings": [
			{
				"command": "editor.action.inlineSuggest.trigger",
				"key": "alt+\\",
				"mac": "alt+\\",
				"when": "(editorLangId == 'apex'|| editorLangId == 'javascript' || editorLangId == 'css'|| editorLangId == 'html') && editorTextFocus && !editorReadonly && salesforcedx-einstein-gpt.isEnabled"
			},
			{
				"command": "salesforce.agentforceVibesAutocomplete.toggleAutocompletions",
				"key": "alt+a",
				"mac": "alt+a",
				"when": "(editorLangId == 'apex'|| editorLangId == 'javascript' || editorLangId == 'css'|| editorLangId == 'html') && editorTextFocus && !editorReadonly && salesforcedx-einstein-gpt.isEnabled"
			},
			{
				"command": "salesforce.agentforceVibesAutocomplete.clearSuggestion",
				"key": "escape",
				"mac": "escape",
				"when": "(editorLangId == 'apex'|| editorLangId == 'javascript' || editorLangId == 'css'|| editorLangId == 'html') && editorTextFocus && !editorReadonly && salesforcedx-einstein-gpt.isEnabled && inlineSuggestionVisible"
			}
		],
		"icons": {
			"egpt-einstein-logo": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-einstein-logo.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E909"
				}
			},
			"egpt-einstein-logo-with-slash": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-einstein-logo-with-slash.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E906"
				}
			},
			"egpt-einstein-logo-sleepy-state": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-einstein-logo-sleepy-state.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E908"
				}
			},
			"egpt-generate-test": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-einstein-test.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E911"
				}
			},
			"egpt-optimize": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-egpt-optimize.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E90C"
				}
			},
			"egpt-agents": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-agents.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E904"
				}
			},
			"egpt-dev-assistant-outline": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-dev-assistant-outline.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E907"
				}
			},
			"vibe-codey": {
				"description": "%salesforcedx-einstein-gpt.icons.vibe-codey.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E913"
				}
			},
			"vibe-codey-slash": {
				"description": "%salesforcedx-einstein-gpt.icons.egpt-einstein-logo-with-slash.description%",
				"default": {
					"fontPath": "resources/sfdx-icons.woff2",
					"fontCharacter": "\\E914"
				}
			}
		},
		"configuration": {
			"title": "%salesforcedx-einstein-gpt.settings.title%",
			"order": 0,
			"properties": {
				"salesforce.agentforceVibesAutocomplete.enable": {
					"type": "boolean",
					"default": true,
					"description": "%salesforcedx-einstein-gpt.configuration.enable.description%",
					"markdownDeprecationMessage": "Deprecated. Agentforce Vibes Autocomplete is now gated by the shared `salesforce.einsteinForDevelopers.enable` setting, enabled when you accept the terms in Agentforce Vibes. This legacy setting is only read to preserve a prior opt-in on upgrade.",
					"order": 1
				},
				"salesforce.agentforceVibesAutocomplete.enableAutocompletions": {
					"type": "boolean",
					"default": true,
					"description": "%salesforcedx-einstein-gpt.configuration.enableAutocompletions.description%",
					"order": 2
				},
				"salesforce.agentforceVibesAutocomplete.enableAutocompletionsByFileType": {
					"type": "object",
					"additionalProperties": {
						"type": "boolean"
					},
					"default": {
						"apex": true,
						"javascript": true,
						"css": true,
						"html": true
					},
					"description": "%salesforcedx-einstein-gpt.configuration.enableAutocompletionsByFileType.description%",
					"order": 3
				},
				"salesforce.agentforceVibesAutocomplete.enableInlineIndicatorForAutocomplete": {
					"type": "boolean",
					"default": true,
					"description": "%salesforcedx-einstein-gpt.configuration.enableInlineIndicatorForAutocomplete.description%",
					"order": 4
				},
				"salesforce.agentforceVibesAutocomplete.enableAutocompletionsSleepModeMonitoring": {
					"type": "boolean",
					"default": true,
					"description": "%salesforcedx-einstein-gpt.configuration.enableAutocompletionsSleepModeMonitoring.description%",
					"order": 5
				},
				"salesforce.agentforceVibesAutocomplete.enableDebugLogging": {
					"type": "boolean",
					"default": false,
					"description": "%salesforcedx-einstein-gpt.configuration.enableDebugLogging.description%",
					"order": 6
				},
				"salesforce.agentforceVibesAutocomplete.advanced": {
					"type": "object",
					"title": "Advanced Settings",
					"properties": {
						"inlineSuggestDelay": {
							"type": "integer",
							"default": 250,
							"description": "Number of milliseconds to use for delay"
						}
					},
					"order": 7
				}
			}
		},
		"walkthroughs": [
			{
				"id": "einsteinGPT",
				"title": "%salesforcedx-einstein-gpt.walkthroughs.einsteinGPT.title%",
				"description": "%salesforcedx-einstein-gpt.walkthroughs.einsteinGPT.description%",
				"steps": [
					{
						"id": "einsteinGPTStep6",
						"title": "%salesforcedx-einstein-gpt.walkthroughs.einsteinGPTStep6.title%",
						"description": "%salesforcedx-einstein-gpt.walkthroughs.einsteinGPTStep6.description%",
						"media": {
							"image": {
								"dark": "resources/walkthrough-autocomplete-dark.svg",
								"hc": "resources/walkthrough-autocomplete-dark.svg",
								"light": "resources/walkthrough-autocomplete-light.svg",
								"hcLight": "resources/walkthrough-autocomplete-light.svg"
							},
							"altText": "Inline code completions"
						}
					}
				]
			}
		]
	},
